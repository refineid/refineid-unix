name: refineid
version: "@VERSION@"
origin: security/refineid
comment: "FINEID middleware for Finnish identity cards"
desc: <<EOD
RefineID is an open-source FINEID smart-card middleware for Finnish
identity cards: the refineid command-line tool, the RefineID desktop
application, and a PKCS#11 module that Firefox, Chromium and p11-kit
programs use for card login and signing.
EOD
maintainer: "petri.koistinen@refineid.fi"
www: "https://github.com/refineid/refineid-unix"
prefix: "/usr/local"
categories: [security]
licenselogic: single
licenses: [APACHE20]
messages: [
  { type: install, message: <<EOD
Run once as root, or reboot, to start pcscd and load the devd rule that
enables Bluetooth LE on USB Bluetooth adapters:
  service pcscd restart
  service devd restart
EOD
  },
  { type: upgrade, message: <<EOD
Run once as root, or reboot, to start pcscd and load the devd rule that
enables Bluetooth LE on USB Bluetooth adapters:
  service pcscd restart
  service devd restart
EOD
  },
  { type: remove, message: <<EOD
Run once as root, or reboot, to drop the Bluetooth LE devd rule:
  service devd restart
EOD
  }
]
