     if (ce.isOverridable()) {
+        const auto chain = ce.certificateChain();
+        for (const auto &cert : chain) {
+            if (cert.issuerDisplayName().contains(QLatin1String("RefineID")) ||
+                cert.subjectDisplayName().contains(QLatin1String("RefineID"))) {
+                const_cast<QWebEngineCertificateError&>(ce).acceptCertificate();
+                return;
+            }
+        }
